# Required in production. Use a long random string, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: connect to a local Ollama instance for real embeddings and generation.
# Leave these unset to use the built-in hashed embeddings and extractive answers.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
