# Primary LLM provider. Any OpenAI-compatible /chat/completions API works.
# Example for Groq: https://api.groq.com/openai/v1 with a model such as llama-3.3-70b-versatile.
# Copy this file to .env.local and put your real key there. Never commit real keys.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings are separate. Groq has no embeddings API, so set this to none
# to use the built-in local embeddings while still using the hosted chat model.
# For a provider that does offer /embeddings, set the model and optional base URL.
LLM_EMBED_MODEL=none
# LLM_EMBED_BASE_URL=https://api.openai.com/v1

# Fallback: a local Ollama instance, used when no hosted chat is configured.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Required in production. Use a long random string, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
